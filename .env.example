BLOCK_MEDIA=true
LOGGING_LEVEL=info
FIRECRAWL_API_ENV_FILE=./secrets/api.env
BACKUP_HELPER_IMAGE=alpine:3.22.1@sha256:4bcff63911fcb4448bd4fdacec207030997caf25e9bea4045fa6c8c44de311d1
